# ---- copy to .env and edit ----

# Where the web UI listens (inside the container).
BIND_ADDR=0.0.0.0:8080
# Host port published by docker-compose.
HOST_PORT=8080

# Persistent data (SQLite db + uploaded/normalized media). Keep as-is for Docker.
DATA_DIR=/app/data

# First-run admin account. CHANGE THESE before first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Session cookie signing key. Must be >= 64 random bytes, e.g.:
#   openssl rand -hex 48
SECRET_KEY=

# Max upload size per file, in MB. Set to 0 for no limit (uploads stream to disk,
# so large files do not buffer in memory).
MAX_UPLOAD_MB=4096

# ffmpeg binary (the Docker image already bundles ffmpeg).
FFMPEG_BIN=ffmpeg

# Default RTMP ingest URL pre-filled for new streams.
YOUTUBE_INGEST_URL=rtmp://a.rtmp.youtube.com/live2

# ---- optional: YouTube account integration (OAuth) ----
# Create an OAuth client (type "Web application") in Google Cloud Console,
# enable the "YouTube Data API v3", and set the redirect URI to:
#   http(s)://<your-host>:<port>/youtube/callback
# Leaving these blank keeps infistreamer in stream-key-only mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=

# Log level.
RUST_LOG=info,infistreamer=debug
